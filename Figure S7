# FIGURE S7D
COL_sample <- readRDS("COL_sample.rds")
DimPlot(COL_sample, label = TRUE)
FeaturePlot(object = COL_sample, features = "TRDV1", order = TRUE)
FeaturePlot(object = COL_sample, features = "TRDV2", order = TRUE)
FeaturePlot(object = COL_sample, features = "TRDV3", order = TRUE)
FeaturePlot(object = COL_sample, features = "RORC", order = TRUE)
FeaturePlot(object = COL_sample, features = "MAF", order = TRUE)
FeaturePlot(object = COL_sample, features = "CCR6", order = TRUE)
FeaturePlot(object = COL_sample, features = "KLRB1", order = TRUE)
FeaturePlot(object = COL_sample, features = "TBX21", order = TRUE)


#Heatmap  - S7E
cluster_markers <- FindAllMarkers(COL_sample, only.pos = TRUE, logfc.threshold = 1, min.pct = 0.25)
top10 <- cluster_markers %>% group_by(cluster) %>% slice_head(n = 10) 
COL_sample <- ScaleData(COL_sample, features = top10$gene)
DoHeatmap(COL_sample, features = top10$gene, size = 5, raster = FALSE,  label = TRUE,
          draw.lines = FALSE) +  scale_fill_gradientn(colors = rev(RColorBrewer::brewer.pal(n =4, name = "RdBu"))) + guides(color = "none")


# FIGURE S7F
RORC_COL <- subset(COL_sample, RORC > 0)
Idents(RORC_COL) <- "SCT_snn_res.0.1"
gdt_related = c("RORC", "MAF","TBX21", "CCR6", "CXCR6", "IL23R", "RORA", "DPP4", "BLK", "BHLHE40", "KLRB1","ZBTB16")
percent <- Percent_Expressing(seurat_object = RORC_COL, features = gdt_related)
percent_entire_object <- Percent_Expressing(seurat_object = RORC_COL, features = gdt_related, entire_object= TRUE)
percent_entire_object <- as.data.frame(percent_entire_object)
gene_names <- rownames(percent_entire_object)
percentages <- percent_entire_object$All_Cells
coexpression_data <- data.frame(Gene = gene_names, Percentage = percentages)
coexpression_data$FillColor <- ifelse(coexpression_data$Gene == "RORC", "#ff8346", "#f8766d")
ggplot(coexpression_data, aes(x = reorder(Gene, -Percentage), y = Percentage, fill = FillColor)) +
  geom_bar(stat = "identity", width = 0.7) +
  labs(title = "human cLP", x = "Genes", y = "% of RORC+ γδ T cells expressing shown genes") + scale_fill_identity() +
  scale_y_continuous(limits = c(0, max(coexpression_data$Percentage)), expand = c(0, 0)) +
  theme_minimal() + theme(axis.text.x = element_text(angle = 45, hjust = 1), axis.line = element_line(color = "black"))


# FIGURE S7G
cluster.averages <- AverageExpression(COL_sample, assays = "SCT",  group.by = "ident", return.seurat = TRUE)
gene_order <- c("JUNB", "NR4A2", "NR4A3", "FOSL2", "AREG", "CTLA4","ITGA1","LITAF", "FASLG", "MAF","CCL20", "BHLHE40", 
                "SLAMF7", "RORC", "TBX21","IFNG", "PTGS2",  "NR4A1", "LIF")
DoHeatmap(cluster.averages, features = gene_order, size = 5, raster = FALSE,  label = TRUE, group.by = "orig.ident",
          draw.lines = FALSE) +  scale_fill_gradientn(colors = rev(RColorBrewer::brewer.pal(n =4, name = "RdBu"))) + guides(color = "none")
