# FIGURE S3F
load("processed_data.Rdata")
gdT_signature <- c("Ctla4", "Ifng", "Ptgs2", "Cxcl3", "Lif", "Il22", "Nr4a1", "Nr4a2", "Nr4a3", "Areg", "Tbx21", 
                   "Rorc", "Maf", "Slamf7", "Fasl", "Itga1", "Junb", "Fosl2", "Bhlhe40", "Ccl20", "Osgin1", "Litaf")
gsvaPar <- gsvaParam(exprData = expr_tpm_keep, geneSets = list(gdT = gdT_signature))
gdT_enrich <- gsva(gsvaPar)
gdT_enrich <- as.data.frame(gdT_enrich)
group_names <- c("LN_gdT1", "LN_gdT17", "siLP_gdT1", "siLP_gdT17", "coLP_gdT1", "coLP_gdT17")
gdT_enrich <- gdT_enrich %>% pivot_longer(cols = matches("[a-z][1-6]$"), names_to = "replicate", values_to = "value") %>%
  mutate(number = as.numeric(str_extract(replicate, "[1-6]$")), group  = group_names[number]) %>% select(-number)
cols <- c("LN_gdT17" = "#0095ff", "LN_gdT1" = "#3600ff", "coLP_gdT1" = "#ca95c2","siLP_gdT1" = "#ca9591", 
          "coLP_gdT17" = "#faaa32", "siLP_gdT17" = "#ff3200")
write.xlsx(gdT_enrich, "gdT_enrich.xlsx")
ggplot(gdT_enrich, aes(x = reorder(group, value, FUN = mean), y = value, color = group)) + scale_color_manual(values = cols) +
  geom_jitter(width = 0.15, size = 3) + theme_classic() + labs(x = "Group", y = "Value") + theme(legend.position = "none")
