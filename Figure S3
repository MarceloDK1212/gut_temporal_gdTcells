# FIGURE S3B
load("processed_data.Rdata")
samples <- read.table("sampleTable.tsv", sep="\t", header = TRUE)
expr_sub <- expr_tpm[,colnames(expr_tpm) %in% samples[samples$condition == "wt",]$sample]
expr_sub <- expr_sub[!rowSums(expr_sub) == 0, ]
pca <- prcomp(t(expr_sub), scale. = TRUE)
df <- data.frame(PC1 = pca$x[,1], PC2 = pca$x[,2], organ = samples[samples$condition == "wt",]$organ, 
                 sample = colnames(expr_sub), subset = samples[samples$condition == "wt",]$subset, 
                 group = samples[samples$condition == "wt",]$group)
ggplot(df, aes(x = PC1, y = PC2, color = group)) +
  geom_point(size = 3) +
  scale_color_manual("group", values = c(si_dp = "#FF3200", clp_dp = "#FAAA32", pln_gfp = "#0095FF", si_amcyan = 
                                           "#CA9591", clp_amcyan = "#CA95C2", pln_amcyan = "#3600FF")) +
  xlab(paste0("PC1 (", round(summary(pca)[[6]][2,1]*100, digits = 2), "%)")) +
  ylab(paste0("PC2 (", round(summary(pca)[[6]][2,2]*100, digits = 2), "%)")) + theme_bw()


